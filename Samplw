SELECT a.execution_id,

       LISTAGG(
           CASE
               WHEN resolved_names IS NOT NULL
               THEN REGEXP_REPLACE(
                        x.token,
                        ':(.*)$',
                        ':' || resolved_names
                    )
               ELSE x.token
           END,
           CHR(10)
       ) WITHIN GROUP (ORDER BY x.lvl) AS mandatorycheck_output

FROM euc_data_validation_audit a

CROSS JOIN LATERAL (

    SELECT LEVEL lvl,

           TRIM(
               REGEXP_SUBSTR(
                   DBMS_LOB.SUBSTR(a.mandatorycheck_details, 4000, 1),
                   '[^|]+',
                   1,
                   LEVEL
               )
           ) AS token,

           (
               SELECT LISTAGG(v.column_name, ',')
                      WITHIN GROUP (ORDER BY v.column_id)

               FROM (

                    SELECT TRIM(
                               REGEXP_SUBSTR(
                                   REGEXP_SUBSTR(
                                       TRIM(
                                           REGEXP_SUBSTR(
                                               DBMS_LOB.SUBSTR(a.mandatorycheck_details, 4000, 1),
                                               '[^|]+',
                                               1,
                                               LEVEL
                                           )
                                       ),
                                       '[^:]+$',
                                       1,
                                       1
                                   ),
                                   '[^,]+',
                                   1,
                                   LEVEL
                               )
                           ) AS col_id
                    FROM dual
                    CONNECT BY LEVEL <=
                        REGEXP_COUNT(
                            REGEXP_SUBSTR(
                                TRIM(
                                    REGEXP_SUBSTR(
                                        DBMS_LOB.SUBSTR(a.mandatorycheck_details, 4000, 1),
                                        '[^|]+',
                                        1,
                                        LEVEL
                                    )
                                ),
                                '[^:]+$',
                                1,
                                1
                            ),
                            ','
                        ) + 1
               ) c

               JOIN euc_report_data_validations v
                    ON v.reportid = a.reportid
                   AND v.column_id = c.col_id

           ) AS resolved_names

    FROM dual

    CONNECT BY LEVEL <=
        REGEXP_COUNT(
            DBMS_LOB.SUBSTR(a.mandatorycheck_details, 4000, 1),
            '\|'
        ) + 1

) x

GROUP BY a.execution_id;
