CASE
    WHEN (
        SELECT COUNT(*)
        FROM (
            SELECT TRIM(
                       REGEXP_SUBSTR(
                           REGEXP_SUBSTR(x.token, '[^:]+$', 1, 1),
                           '[^,]+',
                           1,
                           LEVEL
                       )
                   ) col_id
            FROM dual
            CONNECT BY LEVEL <=
                REGEXP_COUNT(
                    REGEXP_SUBSTR(x.token, '[^:]+$', 1, 1),
                    ','
                ) + 1
        ) c
        JOIN euc_report_data_validations v
             ON v.reportid = a.reportid
            AND v.column_id = c.col_id
    ) > 0

    THEN
        REGEXP_REPLACE(
            x.token,
            ':.*$',
            ':' || (
                SELECT LISTAGG(v.column_name, ',')
                       WITHIN GROUP (ORDER BY v.column_id)
                FROM (
                    SELECT TRIM(
                               REGEXP_SUBSTR(
                                   REGEXP_SUBSTR(x.token, '[^:]+$', 1, 1),
                                   '[^,]+',
                                   1,
                                   LEVEL
                               )
                           ) col_id
                    FROM dual
                    CONNECT BY LEVEL <=
                        REGEXP_COUNT(
                            REGEXP_SUBSTR(x.token, '[^:]+$', 1, 1),
                            ','
                        ) + 1
                ) c
                JOIN euc_report_data_validations v
                     ON v.reportid = a.reportid
                    AND v.column_id = c.col_id
            )
        )

    ELSE x.token
END
