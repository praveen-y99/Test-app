SELECT t.execution_id,
       LISTAGG(t.final_token, CHR(10))
           WITHIN GROUP (ORDER BY t.lvl) AS mandatorycheck_output
FROM (
    SELECT a.execution_id,
           x.lvl,

           REGEXP_SUBSTR(x.token, '^[^:]+') || ':' ||

           (
               SELECT LISTAGG(v.column_name, ',')
                      WITHIN GROUP (ORDER BY v.column_id)
               FROM (
                    SELECT TRIM(
                               REGEXP_SUBSTR(
                                   REGEXP_SUBSTR(x.token, '[^:]+$', 1, 1),
                                   '[^,]+',
                                   1,
                                   LEVEL
                               )
                           ) AS col_id
                    FROM dual
                    CONNECT BY LEVEL <=
                        REGEXP_COUNT(
                            REGEXP_SUBSTR(x.token, '[^:]+$', 1, 1),
                            ','
                        ) + 1
               ) c
               JOIN euc_report_data_validations v
                    ON v.report_id = a.report_id
                   AND v.column_id = c.col_id
           ) AS final_token

    FROM euc_data_validation_audit a

    CROSS JOIN LATERAL (
        SELECT LEVEL lvl,
               TRIM(
                    REGEXP_SUBSTR(
                        a.mandatorycheck_details,
                        '[^|]+',
                        1,
                        LEVEL
                    )
               ) AS token
        FROM dual
        CONNECT BY LEVEL <=
            REGEXP_COUNT(a.mandatorycheck_details, '\|') + 1
    ) x
) t
GROUP BY t.execution_id;
