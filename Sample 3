CREATE OR REPLACE FUNCTION format_validation_details (
    p_reportid IN NUMBER,
    p_details  IN CLOB
)
RETURN CLOB
IS
    l_result CLOB;
BEGIN

    SELECT LISTAGG(
               prefix || ':' || mapped_cols,
               CHR(10)
           ) WITHIN GROUP (ORDER BY lvl)
    INTO l_result
    FROM (
        SELECT t.lvl,
               TRIM(REGEXP_SUBSTR(t.token,'^[^:]+')) prefix,

               LISTAGG(
                   NVL(v.column_name,c.col_id),
                   ','
               ) WITHIN GROUP (ORDER BY c.pos) mapped_cols

        FROM (
            SELECT LEVEL lvl,
                   TRIM(REGEXP_SUBSTR(
                       DBMS_LOB.SUBSTR(p_details,4000,1),
                       '[^|]+',
                       1,
                       LEVEL
                   )) token
            FROM dual
            CONNECT BY LEVEL <=
                REGEXP_COUNT(
                    DBMS_LOB.SUBSTR(p_details,4000,1),
                    '\|'
                ) + 1
        ) t

        CROSS APPLY (
            SELECT LEVEL pos,
                   TRIM(REGEXP_SUBSTR(
                       REGEXP_SUBSTR(t.token,'[^:]+$',1,1),
                       '[^,]+',
                       1,
                       LEVEL
                   )) col_id
            FROM dual
            CONNECT BY LEVEL <=
                REGEXP_COUNT(
                    REGEXP_SUBSTR(t.token,'[^:]+$',1,1),
                    ','
                ) + 1
        ) c

        LEFT JOIN euc_report_data_validations v
               ON v.reportid = p_reportid
              AND v.column_id = c.col_id

        GROUP BY t.lvl,
                 TRIM(REGEXP_SUBSTR(t.token,'^[^:]+'))
    );

    RETURN l_result;

EXCEPTION
    WHEN OTHERS THEN
        RETURN DBMS_LOB.SUBSTR(p_details,4000,1);
END;
/




CREATE OR REPLACE VIEW vw_data_validation_audit AS
SELECT a.*,

       format_validation_details(
           a.reportid,
           a.mandatorycheck_details
       ) AS mandatorycheck_output,

       format_validation_details(
           a.reportid,
           a.datatypecheckdetails
       ) AS datatypecheck_output

FROM euc_data_validation_audit a;
/
